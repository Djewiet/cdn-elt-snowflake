# Copy to .env and fill in. .env is git-ignored.

# --- Airflow
AIRFLOW_UID=50000
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# openssl rand -hex 32
AIRFLOW_JWT_SECRET=
CDN_START_DATE=2026-11-01T00:00:00+00:00

# --- AWS landing bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
CDN_LANDING_BUCKET=my-cdn-landing-bucket
CDN_LANDING_PREFIX=cdn_logs

# --- Snowflake (account identifier: <orgname>-<account_name>)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_LOADER_USER=SVC_CDN_LOADER
SNOWFLAKE_TRANSFORMER_USER=SVC_CDN_TRANSFORMER
# Private keys go in ./secrets/loader_rsa_key.p8 and ./secrets/transformer_rsa_key.p8
